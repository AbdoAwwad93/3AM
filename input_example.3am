import "io"
schedule second add(second a, second b){
   finish a+b;
}
minute startClock() {
 moment name;
 minute  age= 4.5;
 
 tickout "Enter your name: ";
 tickin name;
 
 tickout "Enter your age: ";
 tickin age;
 when(age>=20){
    tickout "your age is more than 20, HI Man";
 }
 otherwise{
    tickout "your age is small , Hi Kid";
 }
 tickout "Hello, " + name + "! Age = " + age;
 tickout "result of function call = "+add(1,2);
 finish 0;  
}  