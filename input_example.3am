import "io"
schedule second add(second a, second b){
   finish a+b;
}
minute startClock() {
 moment name;
 minute  age= 4.5;
 
 tickout "Enter your name: ";
 tickin name;
 
 tickout "Enter your age in seconds: ";
 tickin age;
 when(age>=5){
    tickout "your age is bigger";
 }
 otherwise{
    tickout "your name is small"+5+"HI";
 }
 tickout "Hello, " + name + "! Age seconds = " + age;
 tickout add(1,2);
 finish 0;
}
