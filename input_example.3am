import "io"
schedule second add(second a, second b){
   finish a+b;
}
minute startClock() {
 moment name;
 minute  age= 4.5;
 
 tickout "Enter your name: ";
 tickin name;
 
 tickout "Enter your age: ";
 tickin age;
 when(age>=5){
    tickout "your age is bigger";
 }
 otherwise{
    tickout "your name is small "+"HI";
 }
 tickout "Hello, " + name + "! Age = " + age;
 tickout "result of function call = "+add(1,2);
 finish 0;  